[importlinter]
root_packages =
    app
    cowork_harness
    runtime_contract
    model_integrations

[importlinter:contract:harness-independent]
name = Harness must not import product implementation
type = forbidden
source_modules =
    cowork_harness
forbidden_modules =
    app

[importlinter:contract:contract-independent]
name = JSON contract has no product or harness implementation dependency
type = forbidden
source_modules =
    runtime_contract
forbidden_modules =
    app
    cowork_harness

[importlinter:contract:business-independent]
name = Product execution uses the runtime client, not harness internals
type = forbidden
source_modules =
    app.orchestrator
    app.runtime_client
    app.server
    app.automation
    app.industry_apps
    app.host_capabilities
forbidden_modules =
    cowork_harness

[importlinter:contract:providers-independent]
name = Shared model providers have no product or agent implementation dependency
type = forbidden
source_modules =
    model_integrations
forbidden_modules =
    app
    cowork_harness
