{
  "name": "my-cowork",
  "version": "0.1.0",
  "description": "Desktop office automation agent",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite",
    "dev:electron": "tsc && electron dist-electron/main.js",
    "build": "tsc && vite build",
    "build:renderer": "vite build",
    "build:python:mac": "bash scripts/build-python-macos.sh",
    "build:python:windows": "powershell -File scripts/build-python-windows.ps1",
    "prebuild:terminal-deps": "node scripts/preinstall-terminal-deps.cjs && node scripts/fix-venv-paths.cjs && node scripts/fix-symlinks.cjs",
    "build:electron": "bash scripts/build-electron.sh",
    "fetch:officecli": "bash scripts/fetch-officecli.sh",
    "vendor:china-legal-skill": "bash scripts/vendor-china-legal-skill.sh",
    "vendor:official-document-skill": "bash scripts/vendor-official-document-skill.sh",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.43.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "mime": "^4.1.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "unzipper": "^0.12.5",
    "xlsx": "0.18.5",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/unzipper": "^0.10.11",
    "@types/xlsx": "^0.0.36",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^24.1.3",
    "playwright": "^1.62.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
